# WebSocket URL for the game server
# For local development, use:
VITE_WS_URL=ws://localhost:3001
# For production, this will be auto-detected from window.location

# Debug-only: highlight word cells in red on the board. Leave unset/false in
# production. Requires the server to run with DEBUG_WORDS=true as well.
# VITE_DEBUG_WORDS=true
